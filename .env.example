# Moteur par défaut affiché dans l'interface : "local" (Ollama) ou "claude"
QUIZZ_DEFAULT_PROVIDER=local

# --- Version locale (Ollama) ---
OLLAMA_URL=http://localhost:11434
# Modèle et contexte : choisis d'office selon la mémoire du Mac (qwen3.5:9b et 32 768 tokens avec 18 Go).
# Décommente pour imposer un autre choix.
# OLLAMA_MODEL=qwen3.5:9b
# OLLAMA_NUM_CTX=32768

# --- Version API Claude ---
# Colle ta clé après le signe = (elle commence par sk-ant-)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5
